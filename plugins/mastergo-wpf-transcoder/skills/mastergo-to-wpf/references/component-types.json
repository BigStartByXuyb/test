  "tableTemplates": {
    "match": {
      "structural": {
        "nodeTypes": [
          "GROUP"
        ],
        "variant": "Table",
        "signature": {
          "headerGroupNames": [
            "表头"
          ],
          "rowGroupNames": [
            "item"
          ],
          "minRows": 1,
          "minHeaderTexts": 1
        }
      }
    },
    "structuralPolicy": "表格在团队组件库里没有组件集，设计稿里只是一个 GROUP，因此本族**只登记一条命中路径**（没有 match.property，也没有 componentSet）：节点类型 GROUP + 孩子里含名为「表头」的群组 + 至少 minRows 个名为「item」的行群组 + 表头至少有 minHeaderTexts 条可见文本，**四项同时成立**才算命中——这是与设计侧约定的表格结构身份。**图层名不参与匹配**（与「图层名称只用于核对」同一原则），本族因此不是图层名例外，图层如何命名、是否带序号都不改变命中结果。**部分命中**只有一种：表的「表头 + item 行」结构身份成立、但表头没有足够可见文本（列标题无处取值）——此时登记 pending 并写明原因，既不静默套模板，也不静默丢表；结构身份不成立的普通 GROUP 不属于候选，不产生候选记录。",
    "columnControlTypePolicy": "strict-majority-else-TextBlock",
    "columnControlTypePolicyNote": "列 ControlType 由该列各行的单元格机械判定：每个单元格按类型归类（输入框实例取它命中的 ControlType，纯文本取 TextBlock），严格多数（> 50%）胜出；没有严格多数时退化为 TextBlock。判定依据与每列分布写进 mapping.tableAudits[].columns，便于复核与后续调整。",
    "rowPolicy": "row-data-not-emitted",
    "rowPolicyNote": "表格的行是数据（PageData 文件里的记录），不是页面控件：item 行里的左标题 / 单位 / 各列值一律不发射成 IOContorl，按行登记进 mapping.tableAudits[].rows（含单元格的 DSL ref、原文与类型），供工程师据此建数据文件。行数据不得编造，只登记设计稿里真实存在的内容。",
    "innerTextPolicy": {
      "decision": "omit",
      "role": "table-data-cell",
      "note": "命中表格后，表头文本作为列标题被消费（decision=emit，承载在列节点的 Value 上）；表格内其余文本（行标题、单位、单元格文本，含输入框实例内部的固定文本）一律 decision=omit，避免泄漏成根级 TextBlock。该角色已登记进 validate-iocontrol-provenance.js 的 OMIT_ROLES。"
    },
    "valuePolicy": {
      "attr": "Value",
      "decision": "fixed-empty",
      "allowEmpty": true,
      "note": "DataGrid 根节点的 Value 当前阶段**固定写空串**（`Value=\"\"`）：本阶段不再要求 AI 去找数据文件名，数据源由工程师或运行时后续绑定。禁止编造文件名，也不得因为「空串」把该控件判成未完成——它是当前阶段的正式产物形态。",
      "pendingRule": "空串必须同时带 `tableAudits[].valuePending=true` 与 Bundle `tables[].valuePending=true` 作为**待绑定提示**（便于工程师接手时一眼看到哪张表还没绑数据源）；该标记是提示性审计字段，不是交付门禁，也不影响 provenance/坐标门禁的通过。工程师绑定真实数据文件名后把 `valuePending` 置 false。"
    },
    "variants": {
      "Table": {
        "controlType": "DataGrid",
        "style": null,
        "iconPolicy": "none",
        "childPolicy": "columns-from-page-mapping",
        "requiredAttrsNote": "本变体不再登记 requiredAttrs：必写字段集的唯一登记点是本文件顶层的 controlTypeRequiredAttrs.DataGrid（生成器与校验器都只读那一处），此处重复登记会造成第二个真值点。",
        "slots": [
          {
            "slot": "table",
            "controlType": "DataGrid",
            "iconPolicy": "none",
            "note": "本槽位只固定 ControlType 与「根节点就是这张表」的结构事实；根节点属性的来源与占位口径一律以同族 valuePolicy 为唯一真值源，不在此复述。"
          }
        ]
      }
    }
  },
