      "description": "数据表格；Value 为必填且最终配置必须非空，填写 PageData 文件夹下可解析的数据文件名；完全省略 Value 会在 IODataGrid.LoadDataSource 中触发空引用，空字符串仅可用于诊断中间态；列=子 TextBlock/ComboBox（Left=0 Top=0 Height=45）",
      "nested": true,
      "requiredAttrs": [
        "Value"
      ],
      "requiredNonEmptyAttrs": [
        "Value"
      ],
      "attrs": [
        "IOName",
        "IsAutoRefresh",
        "Value",
        "DisableRow",
        "IOCommand"
      ]
    },
    "TabControl": {
      "description": "页签容器；子节点 TabItem（Value=页签名，Height=35）",
      "nested": true,
      "attrs": [
        "IOName",
        "IOEnable",
        "IOCommand"
      ]
    },
    "TabItem": {
      "description": "TabControl 的页签项（仅作为 TabControl 子节点）",
      "nested": false,
      "attrs": [
        "Value",
        "Height",
        "LangName"
      ]
    },
    "ProgressBar": {
      "description": "进度条；MinValue/MaxValue/Value",
      "nested": false,
      "attrs": [
        "MinValue",
        "MaxValue",
        "Value",
        "IOName"
      ]
    },
    "RangeProgressBar": {
      "description": "区间进度条；额外 MinRange/MaxRange",
      "nested": false,
      "attrs": [
        "MinValue",
        "MaxValue",
        "Value",
        "IOName",
        "MinRange",
        "MaxRange"
      ]
    },
    "PowerControl": {
      "description": "实时功率曲线控件；IOName 读值回显",
      "nested": false,
      "attrs": [
        "IOName"
      ]
    },
    "Camera": {
      "description": "相机控件；DesignPanelID=相机编号，Value=相机名，默认宽 560 高 450",
      "nested": false,
      "attrs": [
        "DesignPanelID",
        "IOName",
        "Value",
        "IOSetExposure",
        "IsImagePix",
        "IsExpendPanel",
        "IsCrossingLineSolid",
        "IsCrossingLineHorizontal",
        "IsCrossingLineVertical",
        "IsCrossingMove",
        "ScalingType",
        "IsRightMenu",
        "IsMoveZToFocus",
        "IsLiveImage",
        "IsCenterRec",
        "CenterRecWidth",
        "CenterRecHeight",
        "IsBaseLine",
        "IsHorizontal",
        "IsVertical",
        "IsBaseLineHeight",
        "IsAutoFocus",
        "IsSwicthMode",
        "IsLightControl",
        "IsChangeMode",
        "YReverse"
      ]
    },
    "AutoCutCamera": {
      "description": "自动切割相机；LeftUp/RightUp/RightDownVisibility 控制子窗口显隐",
      "nested": false,
      "attrs": [
        "DesignPanelID",
        "Value",
        "IsLiveImage",
        "LeftUpVisibility",
        "RightUpVisibility",
        "RightDownVisibility"
      ]
    },
    "HighAngleCamera": {
      "description": "高角度相机",
      "nested": false,
      "attrs": [
        "DesignPanelID",
        "Value",
        "IsLiveImage"
      ]
    },
    "LowAngleCamera": {
      "description": "低角度相机",
      "nested": false,
      "attrs": [
        "DesignPanelID",
        "Value",
        "IsLiveImage"
      ]
    },
    "EMTCamera": {
      "description": "EMT 相机；LeftCameraName/RightCameraName 为左右下相机名",
      "nested": false,
      "attrs": [
        "DesignPanelID",
        "LeftCameraName",
        "RightCameraName",
        "IsLiveImage"
      ]
    },
    "Image": {
      "description": "图片；Value=图片绝对路径（如 Z:\\Gui\\Animation\\研磨.png）；带轴属性用于轴位图",
      "nested": false,
      "attrs": [
        "Value",
        "IOAxisName",
        "AxisType",
        "AxisMin",
        "AxisMax",
        "ImageMin",
        "ImageMax",
        "RotatePointX",
        "RotatePointY"
      ]
    }
  },
  "_nested": {
    "description": "布局分组（无控件语义）：保持层级时用无 ControlType 的子 IOContorl 标签（与根节点同形）；框架是否支持需运行时验证，不支持则展平并把子坐标重基于最近有效父容器"
  }
}
