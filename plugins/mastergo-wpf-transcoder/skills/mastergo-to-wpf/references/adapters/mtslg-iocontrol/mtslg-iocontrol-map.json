  "layoutRules": {
    "_note": "底部栏 → Layout MenuItem 的规则。只有布局侧脚本（gen-mtslg-layout-manifest.js / gen-mtslg-layout.js）读取，不参与 IOContorl 模板匹配。",
    "bottomBar": {
      "match": {
        "_note": "底部栏变体的匹配键：componentName=true 表示「变体值 = 被引用组件的名字（实例的 name）」。实测底部栏实例的属性里没有变体信息（properties 只有 实例/显示icon/显示文案/显示F，或为空），它们引用的是独立组件本体（名字即变体值，如 非首页-长方形、首页-长方形），因此底部栏与右栏独立组件族一样按「组件名」匹配；一族一个键，与组件模板族同一套机制。",
        "componentName": true
      },
      "residentGroupPattern": "常驻(button|按钮|分组)",
      "fKeyPattern": "^F\\d+$",
      "decorativeNamePattern": "背景|分割",
      "menuItemFlags": {
        "_note": "MenuItem 的设计稿标记：命中才写属性，未命中不发射该属性（不是恒写字段）。attr / 数值阈值 / exclude* 开关都由 gen-mtslg-layout-manifest.js 与 gen-mtslg-layout.js 直接读取。",
        "redText": {
          "attr": "IsNeedRedMark",
          "minRed": 180,
          "maxGreenBlue": 100,
          "note": "颜色取菜单项文案 TEXT 的 _color（取不到时回退 fill→styles 的值）；属于红色系（R≥minRed 且 G≤maxGreenBlue 且 B≤maxGreenBlue，实测 #F8274B）时写 <attr>=\"true\"。"
        },
        "statusBox": {
          "attr": "IsShowStatus",
          "nodeTypes": ["GROUP", "LAYER"],
          "minSize": 8,
          "maxSize": 32,
          "maxOffsetX": 20,
          "maxOffsetY": 20,
          "excludeIconSubtree": true,
          "note": "菜单项内存在左上角小方框时写 <attr>=\"true\"：节点类型必须在 nodeTypes 内（实测状态方框是 GROUP 组 2492 + LAYER 矩形，图标是 INSTANCE + PATH，因此排除 INSTANCE/PATH/TEXT 即可区分），宽高 minSize–maxSize px，相对菜单项左上角 x≤maxOffsetX 且 y≤maxOffsetY；excludeIconSubtree=true 时再排除图标映射命中的几何子树。实测 18×18@8,8。"
        }
      },
      "menuItemAlwaysWrittenAttrs": [
        "LangName",
        "PageName",
        "IOCommand",
        "IOVisible",
        "IOEnable"
      ],
      "iconSizeAttrs": [
        "IconWidth",
        "IconHeight"
      ],
      "variants": {
        "首页-长方形": {
          "topLeftContent": "none"
        },
        "非首页-长方形": {
          "topLeftContent": "text"
        },
        "方-icon+文案": {
          "topLeftContent": "none"
        },
