{
  "_meta": {
    "source": "{source_root}/docs/Windows_setting/MT3.0 界面设计器.xml（目标项目提供的权威文档）",
    "note": [
      "官方标签拼写为 IOContorl（无字母 e），全部控件统一用该标签，由 ControlType 属性区分。",
      "通用属性对所有控件有效：ID / ControlType / IOEnable / IOVisible / Height / Width / Margin / Left / Top / Style。",
      "LangName 几乎所有控件可用（多语言键，CN/EN 成对，须命中键白名单）。",
      "geometryAttrs 由生成器按 DSL bbox 计算直传，禁止从映射输入覆盖；businessAttrs 从映射 JSON 逐节点透传，生成器不校验内容（键校验交给 mtslg-keys.json 白名单）。",
      "容器类控件（nested=true）可包含子 IOContorl；子控件坐标相对父容器左上角。"
    ]
  },
  "commonAttrs": [
    "ID",
    "ControlType",
    "IOEnable",
    "IOVisible",
    "Height",
    "Width",
    "Margin",
    "Left",
    "Top",
    "Style"
  ],
  "buttonFamily": {
    "controlTypes": [
      "IconButton",
      "Button",
      "StatusButton"
    ],
    "alwaysWrittenAttrs": [
      "PageName",
      "IOVisible",
      "IOCommand",
      "IOEnable"
    ],
    "iconSizeAttrs": [
      "IconWidth",
      "IconHeight"
    ],
      "iconSizeRule": "IconWidth/IconHeight 取图标图形节点 bbox（映射字段 iconSize，四舍五入取整）；模板含图标字段的 IconButton 的 Icon/IconWidth/IconHeight 属于 controlTypeRequiredAttrs 的恒写字段，无图标槽位时写空字符串；Button/StatusButton 的模板不含图标字段，不发射这三项；iconSize 只在模板含图标字段且节点带 Icon 时被消费，带 Icon 却没有 iconSize 视为映射不完整，生成器直接失败"
  },
  "controlTypeRequiredAttrs": {
    "_note": "每个 ControlType 的固定必写字段集（属性恒写，取不到来源时写空字符串）。ID/ControlType 恒由节点身份发射，Left/Top/Width/Height 恒由 DSL bbox 发射（TextBlock 为 Width=NaN、Height=40），因此不重复登记在这里。LangName 是唯一例外：只在多语言绑定层给出真实 key 时发射，动态值等 noLangRefs 豁免节点不写空占位。真值来源：设计方给定的 IOContorl 字段模板。",
    "GroupBox": ["Style", "Header", "LangName", "IOName", "IOEnable", "IOVisible", "MinValue", "MaxValue"],
    "Border": ["Style", "Value", "IOEnable", "IOVisible"],
    "TextBlock": ["Style", "Value", "LangName", "IOName", "IOEnable", "IOVisible", "IsAutoRead", "Foreground", "FontSize"],
    "Button": ["Style", "Value", "LangName", "PageName", "IOCommand", "IOEnable", "IOVisible"],
    "StatusButton": ["Style", "Value", "LangName", "PageName", "IOCommand", "IOEnable", "IOVisible"],
    "IconButton": ["Style", "Value", "LangName", "PageName", "Icon", "TopLeftContent", "IsShowStatus", "IsNeedRedMark", "IOCommand", "IOEnable", "IOVisible", "IconHeight", "IconWidth"],
    "Togglebutton": ["Style", "Value", "IOName", "IOState", "IsAutoRefresh", "IOEnable", "IOVisible"],
    "RadioButton": ["Style", "Value", "IOName", "IOState", "IsAutoRefresh", "IOEnable", "IOVisible"],
    "ComboBox": ["Style", "Value", "IOName", "ItemsSourceFile", "DisplayMemberPath", "SelectedValuePath", "IsAutoRead", "IsAutoWrite", "IsWriteIO", "IOCommand", "IOEnable", "IOVisible"],
    "CheckBox": ["Value", "IOName", "DefaultValue", "IsWriteIO", "IOEnable", "IOVisible"],
    "TextBox": ["Value", "DefaultValue", "IsWriteIO", "Keypad", "IOEnable", "IOVisible"],
    "NumberBox": ["Value", "MinValue", "MaxValue", "DefaultValue", "DecimalPlaces", "IsWriteIO", "Keypad", "IsAutoRead", "IOEnable", "IOVisible"],
    "IntNumberBox": ["Value", "MinValue", "MaxValue", "DefaultValue", "DecimalPlaces", "IsWriteIO", "Keypad", "IsAutoRead", "IOEnable", "IOVisible"],
    "DataGrid": ["Value", "IOName", "IOEnable", "IOVisible"],
    "Camera": ["DesignPanelID", "Value", "IOName"]
  },
  "controlTypeAttrDefaults": {
    "_note": "必写字段在映射没有来源时使用的默认值；未在此登记的字段一律写空字符串。Border 的 Value 是线宽，设计侧模板约定默认 1。",
    "Border": { "Value": "1" }
  },
