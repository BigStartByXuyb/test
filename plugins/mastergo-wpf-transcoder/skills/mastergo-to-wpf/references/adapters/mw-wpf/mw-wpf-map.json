      "layoutAttrs": ["Width", "Height", "Margin", "HorizontalAlignment", "VerticalAlignment", "Grid.Row", "Grid.Column", "Grid.RowSpan", "Grid.ColumnSpan"],
      "protocols": ["Click={s:Action 动作名}", "PageName=\"Jump:…\"", "IOEnable=表达式|true", "IOVisible=表达式"],
      "evidence": ["framework-manual/02-controls/navigation/icon-button.md", "ManualView.xaml（15 处）", "AutoCutView.xaml（6 处）"],
