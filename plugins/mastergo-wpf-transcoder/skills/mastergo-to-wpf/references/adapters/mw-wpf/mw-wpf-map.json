{
  "_meta": {
    "source": "references/adapters/mw-wpf/mw-wpf-map.json",
    "note": [
      "作业A（mw-wpf）写法表：组件类型 → WPF/XAML 怎么写。",
      "组件类型本身（设计稿组件集/变体 → ControlType）由共享类型表 references/component-types.json 唯一决定；本文件只登记「同一类型在 WPF 这一侧怎么写」，不重复类型判定。",
      "控件元素、样式键、属性发射白名单和协议均由本写法表定义；证据列登记可核查的真实页面或程序集依据。",
      "layoutAttrs 是真实页面的抽样证据（记录该类型实际出现过哪些布局属性），不是属性白名单：跨度由布局推导按控件覆盖带数写出，任何可落格类型都可能带 Grid.RowSpan / Grid.ColumnSpan，口径以 mw-wpf-mode.md 为准。",
      "xamlAttrs 是普通 XAML 属性的发射白名单；protocols 是框架协议属性，两者用途不同。",
      "status: 三档按处置区分——ready = 真实页面或程序集证据足以支持映射，按写法表发射；manual-only = 证据不足，仍可发射但门禁 R10 提示人工确认；pending = A 侧没有对应控件或发射通道，遇到即挂待确认、不发射。"
    ]
  },
  "variantRule": {
    "note": "同一类型存在 IO 变体（绑 IO 点）与非 IO 变体时，MW 页面默认用 IO 变体：真实页面里输入/显示控件一律是 s:IOTextBox / s:IOComboBox / s:IOCheckBox / s:IOGroupBox。仅当设计稿该控件不绑 IO 点时用 native 变体。",
    "ioPreferred": true
  },
  "xmlNamespaces": {
    "camera": "clr-namespace:MaxWell.CameraDevice;assembly=MaxWell.CameraDevice"
  },
  "textBinding": {
    "note": "语言键挂到哪个属性：由 ControlType 决定默认属性，样式族可覆盖（真实页面里 RightButtonStyle / UpDownRightButtonStyle 是「图标上+文字下」，文本走 IconText，其余走 Content）。",
    "byControlType": {
      "IconButton": {
        "default": "Content",
        "byStyle": {
          "RightButtonStyle": "IconText",
          "UpDownRightButtonStyle": "IconText"
        }
      },
      "StatusButton": {
        "default": "Value"
      },
      "Button": {
        "default": "Content"
      },
      "CheckBox": {
        "default": "Content"
      },
      "RadioButton": {
        "default": "Content"
      },
      "ToggleButton": {
        "default": "Content"
      },
      "ComboBox": {
        "default": null
      },
      "TextBox": {
        "default": "Text"
      },
      "NumberBox": {
        "default": "Value"
      },
      "IntNumberBox": {
        "default": "Value"
      },
      "TextBlock": {
        "default": "Text"
      },
      "GroupBox": {
        "default": "Header"
      },
      "DataGrid": {
        "default": null
      },
      "Camera": {
        "default": null
      }
    }
  },
  "iconBinding": {
    "note": "图形资源挂到哪个属性；图形名来自本页 Icon 台账（discover → 命名表 → 台账）。",
    "byControlType": {
      "IconButton": "Icon"
    }
  },
  "frameworkTokens": {
    "note": "框架固定区不发射进页面。headerHeight 与 bottomHeight 是本适配器写法表常量，当前值分别为 85 与 180；需要调整时直接修改此处。项目配置不覆盖这些值；布局产物 source 记录对应的框架 Token 名。",
    "headerHeight": 85,
    "bottomHeight": 180
  },
  "styleRules": {
    "note": "外观只走样式族，不散写属性。选中顺序：① byVariant 命中（设计稿变体名）→ 用具名样式键；② 未命中 → 该 ControlType 的 pageDefault（具名键走页级 BasedOn，控件本身不写 Style；取 \"implicit\" 表示走框架隐式默认样式、同样不写 Style）；③ 两者都没有 → fail-closed 报出该变体待确认。命中的样式键逐一写入报告，pageDefault 兜底的记入 styleFallback 供人工评审。",
    "pageDefault": {
      "IconButton": "MainButtonStyle",
      "TextBlock": "TextBlockStyle",
      "Button": "implicit",
      "StatusButton": "implicit",
      "CheckBox": "implicit",
      "ComboBox": "implicit",
      "TextBox": "implicit",
      "NumberBox": "NumberBoxBaseStyle",
      "IntNumberBox": "IntNumberBoxBaseStyle",
      "DataGrid": "DataGridBaseStyle",
      "Camera": "implicit"
    },
    "byVariant": {
      "IconButton": {
        "enter": "RightButtonStyle",
        "exit": "RightButtonStyle",
        "右侧栏-上下结构-icon+文案": "UpDownRightButtonStyle",
        "右侧栏-左右结构-icon+文案": "NormalRightButtonStyle",
        "加减快捷键-无标题": "ButtonIconStyle"
      },
      "GroupBox": {
        "信息分组-模块化": "IOGroupBoxSecondary"
      }
    }
  },
